# Copia este archivo como .env y rellena los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# --- Django ---------------------------------------------------------------
# Clave secreta. En desarrollo puedes dejarla como está; en producción genera
# una nueva:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion

# true en desarrollo, false en producción (activa cookies y cabeceras seguras).
DJANGO_DEBUG=true

# Dominios autorizados, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Integración con IA (OPCIONAL) ----------------------------------------
# Sin esta clave la aplicación funciona solo con reglas (léxico regional y
# búsqueda en el catálogo): no se cae, solo no usa la IA externa.
#
# La clave de API NO es lo mismo que una suscripción de ChatGPT: se obtiene en
# https://platform.openai.com/api-keys y necesita saldo propio.
#
# El modelo, el tiempo de espera, el límite diario por usuario y el
# presupuesto mensual NO van aquí: son parámetros del sistema (RF11) que el
# administrador cambia en /administracion/parametros/.
# Para comprobar la conexión real:  python manage.py probar_ia
OPENAI_API_KEY=

# Alternativa gratuita: un servicio compatible con la API de OpenAI (Groq,
# OpenRouter, Google AI Studio, Cerebras, Mistral…). Pon aquí su clave y, en
# Parámetros, ia_proveedor = compatible, ia_url_compatible e
# ia_modelo_compatible. Lista de servicios con nivel gratuito:
# https://github.com/raullenchai/free-llm-api-resources
IA_COMPATIBLE_API_KEY=
