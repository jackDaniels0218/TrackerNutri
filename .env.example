# Copia este archivo como .env y rellena los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# --- Django ---------------------------------------------------------------
# Clave secreta. En desarrollo puedes dejarla como está; en producción genera
# una nueva:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion

# true en desarrollo, false en producción (activa cookies y cabeceras seguras).
DJANGO_DEBUG=true

# Dominios autorizados, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Integración con IA (OPCIONAL) ----------------------------------------
# Sin esta clave la aplicación funciona con el registro manual: no se cae,
# solo desaparece el botón "Analizar".
#
# IMPORTANTE: la clave de API NO es lo mismo que una suscripción de ChatGPT.
# Son dos productos distintos de OpenAI, con facturación separada:
#   · ChatGPT (incluido el plan gratuito) -> para usar chatgpt.com
#   · Clave de API -> para que un programa como este llame a la API
# Tener ChatGPT, aunque sea de pago, NO da acceso a la API: hay que cargar
# saldo aparte en la plataforma de desarrolladores.
#
# Se obtiene en https://platform.openai.com/api-keys y empieza por "sk-".
OPENAI_API_KEY=

# Modelo a usar. Comprueba cuáles tiene disponibles TU cuenta con:
#   python manage.py probar_ia --solo-modelos
# Si el que pongas aquí no existe en tu cuenta, ese comando te lista los que sí.
OPENAI_MODEL=gpt-4o-mini

# Segundos máximos de espera antes de darse por vencido.
OPENAI_TIMEOUT=20
