# Copia este archivo como .env y rellena los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# --- Django ---------------------------------------------------------------
# Clave secreta. En desarrollo puedes dejarla como está; en producción genera
# una nueva:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion

# true en desarrollo, false en producción (activa cookies y cabeceras seguras).
DJANGO_DEBUG=true

# Dominios autorizados, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Integración con IA (OPCIONAL) ----------------------------------------
# Sin esta clave la aplicación funciona con el registro manual: no se cae,
# solo desaparece el botón "Analizar".
# La clave se obtiene en https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo a usar y segundos de espera máximos.
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=20
